# Server Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Service Metadata
SERVICE_NAME=sentinel-api-backend

# Database Configuration (SentinelAPI PostgreSQL on isolated port 5433)
DATABASE_URL="postgresql://sentinelapi_user:sentinelapi_dev_pass@127.0.0.1:5433/sentinelapi_db?schema=public"
POSTGRES_DB=sentinelapi_db
POSTGRES_USER=sentinelapi_user
POSTGRES_PASSWORD=sentinelapi_dev_pass

# Authentication & JWT Configuration
JWT_SECRET=your_development_jwt_secret_at_least_32_characters_long_placeholder
JWT_EXPIRES_IN=1h

# Rate Limiting & Threat Detection Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MS=300000
EVENT_COOLDOWN_MS=30000

# Incident Aggregation Configuration
INCIDENT_AGGREGATION_WINDOW_MS=900000

# Cryptographic Data Integrity (HMAC-SHA256) Configuration
# Do not reuse the JWT_SECRET as the HMAC_SECRET
HMAC_SECRET=your_dedicated_hmac_secret_at_least_32_bytes_long_placeholder
HMAC_KEY_ID=sentinel-hmac-v1

# NexaCart Store Gateway Upstream Configuration
NEXACART_UPSTREAM_URL=http://127.0.0.1:5001
NEXACART_RATE_LIMIT_MAX=120
NEXACART_RATE_LIMIT_WINDOW_MS=60000
